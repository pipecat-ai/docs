npx lint-staged

# Verify code sample imports still resolve against the framework source.
#
# Opportunistic: this needs a pipecat checkout, which contributors outside the
# core team won't have. The script exits 2 when it can't find one, and that is
# treated as "skip" rather than "fail" — CI runs the same check against a
# checkout it makes itself, so nothing depends on the hook having run.
node scripts/check-imports.mjs >/tmp/pipecat-imports.log 2>&1
status=$?
if [ "$status" = "1" ]; then
  cat /tmp/pipecat-imports.log
  echo
  echo "Fix with: node scripts/check-imports.mjs --fix   (unambiguous renames only)"
  exit 1
fi
