npx lint-staged

# Verify code sample imports still resolve against the framework source.
#
# This needs a pipecat checkout, which contributors outside the core team won't
# have. The script exits 2 when it can't find one; that is a skip rather than a
# failure, but it says so — a check that silently does nothing is worse than one
# that isn't there, because you stop expecting it to catch anything.
#
# CI runs the same check against a checkout it makes itself, so a skip here
# costs review latency, not coverage.
node scripts/check-imports.mjs >/tmp/pipecat-imports.log 2>&1
case $? in
  1)
    cat /tmp/pipecat-imports.log
    echo
    echo "Fix with: node scripts/check-imports.mjs --fix   (unambiguous renames only)"
    exit 1
    ;;
  2)
    echo "note: skipped the code sample import check (no pipecat checkout at ../pipecat)."
    echo "      CI will run it. To run it here, clone pipecat-ai/pipecat beside this repo."
    ;;
esac
